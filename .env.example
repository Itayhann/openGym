# Copy to .env.local for local development (or `vercel env pull .env.local`). Never commit .env.local.
# In production these live only in the Vercel project's environment variables.

# Passkeys are bound to this hostname. It must never change after the first registration.
RP_ID=localhost
ORIGIN=http://localhost:5173

# Pooled connection for the API; unpooled for migrations and the break-glass script.
# Locally point at a throwaway Neon dev branch, never production. Omit DATABASE_URL for `npm run dev:api`
# to use a local on-disk database instead.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# One-time code that lets the first Passkey be registered. Remove it once you have registered.
# Unset or blank means registration is closed.
SETUP_CODE=

# Defaults to 1. Leave it.
MAX_PROFILES=1
